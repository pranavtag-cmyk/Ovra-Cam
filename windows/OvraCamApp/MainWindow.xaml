<Window x:Class="OvraCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ovra Cam" Width="1040" Height="640" MinWidth="860" MinHeight="540"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="Assets/ovracam.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Preview -->
        <Border Grid.Column="0" Margin="20" CornerRadius="16" Background="#000000" ClipToBounds="True">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                <StackPanel x:Name="PreviewHint" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <Image Source="Assets/ovracam.ico" Width="64" Height="64" Opacity="0.9"/>
                    <TextBlock x:Name="HintTitle" Text="Connect your phone" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Dim}" FontSize="13" LineHeight="20"
                               Text="Open Ovra Cam on your phone. Plug it in with USB (USB debugging on), or join the same Wi-Fi - it will appear on the right."/>
                </StackPanel>
                <Border x:Name="FpsBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,4" CornerRadius="8" Background="#99000000" Visibility="Collapsed">
                    <TextBlock x:Name="FpsText" FontSize="12" Text=""/>
                </Border>
            </Grid>
        </Border>

        <!-- Side panel -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel Margin="22,20,22,16">
                <TextBlock DockPanel.Dock="Bottom" Text="Coded by Pranav Tagadpallewar" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/ovracam.ico" Width="30" Height="30"/>
                            <TextBlock Text="Ovra Cam" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- virtual camera status -->
                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CamDot" Width="10" Height="10" Fill="{StaticResource Warn}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CamStatus" Text="Starting virtual camera..." Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="240"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="PHONE"/>
                        <Border Padding="12,10" CornerRadius="10" Background="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PhoneDot" Width="10" Height="10" Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PhoneStatusText" Text="Looking for your phone..." Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="240"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="PhoneList" Margin="0,10,0,0" MinHeight="44" MaxHeight="120" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}"
                                 FontSize="13" DisplayMemberPath="Label"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConnectBtn" Grid.Column="0" Style="{StaticResource PrimaryBtn}" Content="Connect" Click="ConnectBtn_Click"/>
                            <Button x:Name="DisconnectBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Disconnect" Click="DisconnectBtn_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IpBox" ToolTip="Phone's Wi-Fi IP address (shown in the phone app)"/>
                            <Button Grid.Column="2" Style="{StaticResource Btn}" Content="Connect IP" Click="ConnectIp_Click"/>
                        </Grid>
                        <CheckBox x:Name="AutoConnectBox" Content="Connect automatically" Margin="0,10,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <TextBlock Style="{StaticResource Section}" Text="CAMERA"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SwitchBtn" Style="{StaticResource Btn}" Content="Switch camera" Click="SwitchBtn_Click" IsEnabled="False"/>
                            <Button x:Name="TorchBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Light: off" Click="TorchBtn_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="QualityBtn" Style="{StaticResource Btn}" Content="Quality: 720p" Click="QualityBtn_Click"/>
                            <Button x:Name="RotateBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Rotate" Click="RotateBtn_Click"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FocusBtn" Style="{StaticResource Btn}" Content="Focus: auto" Click="FocusBtn_Click" IsEnabled="False" ToolTip="Lock focus at its current distance, so it stops hunting"/>
                            <Button x:Name="RefocusBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Refocus" Click="RefocusBtn_Click" IsEnabled="False" ToolTip="Focus on the centre once, then keep it locked"/>
                        </Grid>
                        <StackPanel x:Name="FocusPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Far" Foreground="{StaticResource Dim}" FontSize="11"/>
                                <TextBlock Text="Focus distance" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="Near" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="FocusSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" Margin="0,4,0,0" ValueChanged="FocusSlider_ValueChanged"/>
                        </StackPanel>
                        <CheckBox x:Name="MirrorBox" Content="Mirror video" Margin="0,10,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <TextBlock Style="{StaticResource Section}" Text="APP"/>
                        <CheckBox x:Name="StartupBox" Content="Start with Windows (in the tray)" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="In Teams, Zoom, Meet, OBS or the Camera app, choose &quot;Ovra Cam&quot; as your camera. Keep this app running - closing the window hides it to the tray."
                                   TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" LineHeight="18" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
